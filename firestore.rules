rules_version = '2';

// =============================================================================
// Crate — Firestore Security Rules
// =============================================================================
// עקרון-על: ברירת המחדל היא "אין גישה". כל אוסף חייב לקבל אישור מפורש.
// שום דבר לא נסמך על מה שנשלח מהלקוח (title, from, to וכו') — כל שדה קריטי
// נגזר מ-request.auth או מבוקר בזמן כתיבה.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---------------------------------------------------------------------
    // users/{userId} — פרופיל ציבורי מוגבל (שם תצוגה, לא מידע רגיש)
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'; // אף אחד לא יכול ליצור את עצמו כאדמין
      allow update: if
        // המשתמש עצמו יכול לעדכן את עצמו, אבל לא את role/blocked
        (isOwner(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('blocked', false) == resource.data.get('blocked', false))
        ||
        // אדמין יכול לשנות אך ורק role או blocked של משתמש אחר — שום שדה אחר
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'blocked']));
      allow delete: if false; // מחיקת חשבון עוברת דרך Cloud Function ייעודית, לא ישירות

      // -------------------------------------------------------------------
      // users/{userId}/collection/{itemId} — האוסף האישי
      // -------------------------------------------------------------------
      match /collection/{itemId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['title', 'artist', 'quantity'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() < 200
          && request.resource.data.artist is string
          && request.resource.data.artist.size() < 200
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 1
          && request.resource.data.quantity < 1000
          && (!('price' in request.resource.data) || request.resource.data.price is number && request.resource.data.price >= 0)
          && (!('tradeType' in request.resource.data) || request.resource.data.tradeType == null || request.resource.data.tradeType in ['sell', 'trade']);
        allow delete: if isOwner(userId);
      }

      // -------------------------------------------------------------------
      // users/{userId}/wantlist/{itemId} — רשימת חוסרים אישית
      // -------------------------------------------------------------------
      match /wantlist/{itemId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() < 200;
        allow delete: if isOwner(userId);
      }
    }

    // ---------------------------------------------------------------------
    // apiCache/{externalId} — מטמון תוצאות Discogs/MusicBrainz
    // כתיבה רק דרך שרת (Cloudflare Worker עם Admin SDK), לא מהלקוח,
    // כדי שאף אחד לא "יזריק" מידע שקרי לקטלוג המשותף.
    // ---------------------------------------------------------------------
    match /apiCache/{externalId} {
      allow read: if isSignedIn();
      allow write: if false; // רק Admin SDK (שעוקף rules) יכול לכתוב לכאן
    }

    // ---------------------------------------------------------------------
    // duplicatesIndex/{recordId}/holders/{userId} — מי מחזיק עותקים כפולים
    // כל משתמש יכול לכתוב רק את הרשומה שמייצגת אותו עצמו.
    // ---------------------------------------------------------------------
    match /duplicatesIndex/{recordId}/holders/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // ---------------------------------------------------------------------
    // messages/{messageId} — הודעות בין משתמשים
    // הכי רגיש: senderId נקבע מה-auth, לא מהלקוח. רק שני הצדדים קוראים.
    // מבנה (לפי המפרט): senderId, receiverId, message, createdAt, read, relatedRecordId
    // ---------------------------------------------------------------------
    match /messages/{messageId} {
      allow read: if isSignedIn() &&
        (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid // אי אפשר להתחזות לשולח
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid   // אי אפשר לשלוח לעצמך
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 2000        // הגנה מפני ספאם/abuse
        && request.resource.data.createdAt == request.time
        && request.resource.data.read == false;

      // עדכון מותר רק לסימון "נקרא", ורק לצד המקבל
      allow update: if isSignedIn()
        && resource.data.receiverId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      // מחיקה מותרת לכל אחד מהצדדים בשיחה (מחיקת הודעה מהתיבה שלו)
      allow delete: if isSignedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    // ---------------------------------------------------------------------
    // ברירת מחדל: כל מה שלא הוגדר במפורש למעלה — חסום.
    // ---------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
